# Database
DATABASE_URL=postgresql://arena:arena@localhost:5433/arena
# Hosted (see DEPLOY.md): pooled URL above, direct URL here for migrations, and
# DATABASE_POOLER=1 so queries skip prepared statements.
# DATABASE_URL_UNPOOLED=
# DATABASE_POOLER=1

# Auth
AUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Who can sign in: a Google Workspace domain and/or a list of addresses.
# With neither set, nobody can sign in.
ALLOWED_EMAIL_DOMAIN=yourcompany.com
# ALLOWED_EMAILS=ana@gmail.com,bo@gmail.com

# Public base URL (used for arena:// pairing links)
PUBLIC_BASE_URL=http://localhost:3000

# GitHub repo (owner/repo) with Mac releases, for the download link.
# On Vercel it defaults to the repo the project deploys from.
# ARENA_RELEASES_REPO=yourname/arena

# Optional launch day (YYYY-MM-DD, company timezone): nothing before it counts,
# and older data is deleted on each deploy (pnpm db:migrate).
# ARENA_START_DATE=2026-10-05

# Company timezone for leaderboard weeks
ARENA_TIMEZONE=UTC

# Node environment
NODE_ENV=development
